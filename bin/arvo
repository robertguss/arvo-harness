#!/usr/bin/env bash
# Thin PATH wrapper (SPEC §12): capture launch dir, run mix from the arvo checkout via mise.
set -euo pipefail

export ARVO_CWD="${ARVO_CWD:-$PWD}"

# Resolve PATH symlinks (BASH_SOURCE is the invoke path, e.g. ~/.local/bin/arvo).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
# bin/arvo lives in the mix project root's bin/; checkout = parent of bin.
CHECKOUT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${CHECKOUT}"

if command -v mise >/dev/null 2>&1; then
  exec mise exec -- mix run --no-halt "$@"
else
  exec mix run --no-halt "$@"
fi
