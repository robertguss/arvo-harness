# Copy to .env (gitignored). Do not paste tokens in chat.
#
# Portal app: OAuth 2.0 user auth (not OAuth 1.0a).
# Callback URL must match exactly:
#   http://127.0.0.1:8765/callback
# Scopes: bookmark.read tweet.read users.read offline.access
#
# X_CLIENT_ID=
# X_CLIENT_SECRET=
#
# Filled by scripts/x_oauth_pkce.py after you authorize:
# X_USER_BEARER=
# X_REFRESH_TOKEN=
# X_USER_ID=
